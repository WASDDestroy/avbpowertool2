# AVBPowerTool2

# Runtime data — user-specific, generated, or private
profiles/
Logs/
Images/
Configs/
Keys/
*.zip

# Plugin key material stays local (the plugin itself is tracked)
plugins/*/keys/

# Tracked test fixtures (must not be swallowed by the runtime-data rules above)
!tests/fixtures/legacy/keys/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual env
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Compiled gettext
*.mo

# Staging
.avbpowertool-staging/

# Runtime generated files
settings.json
.active-profile

# References (old project)
/references/

# Mimocode
.mimocode/

# pytest temp
.pytest_cache/
.pytest_tmp/